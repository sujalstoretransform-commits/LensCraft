{% assign selected_variant = product.selected_or_first_available_variant %}

{% if product %}
  <div
    class="lenscraft-customize"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
    data-variant-title="{{ selected_variant.title | escape }}"
    data-variant-image="{% if selected_variant.featured_image %}{{ selected_variant.featured_image | image_url: width: 1200 }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
    data-shop="{{ shop.permanent_domain }}"
    data-currency="{{ cart.currency.iso_code }}"
  >
    <button
      type="button"
      class="lenscraft-customize__button"
      data-lenscraft-customize
    >
      Customize Lens
    </button>
  </div>

  <style>
    .lenscraft-customize {
      width: 100%;
      margin: 12px 0;
    }

    .lenscraft-customize__button {
      width: 100%;
      padding: 14px 20px;
      border: 0;
      border-radius: 5px;
      background: #000;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    .lenscraft-customize__button:hover {
      background: #292929;
    }
  </style>

  <script>
    (() => {
      const CONFIGURATOR_URL = 'https://lens-craft-five.vercel.app/configurator';

      const block = document.currentScript?.closest('.shopify-section')?.querySelector('.lenscraft-customize');

      if (!block) return;

      const button = block.querySelector('[data-lenscraft-customize]');

      button?.addEventListener('click', async () => {
        const productForm = document.querySelector('form[action*="/cart/add"]');

        const variantInput = productForm?.querySelector('[name="id"]');
        const variantId = variantInput?.value || block.dataset.variantId;

        if (!variantId) {
          alert('Please select a frame colour first.');
          return;
        }

        try {
          const handle = window.location.pathname.split('/products/')[1]?.split('/')[0];

          if (!handle) throw new Error('Product handle not found.');

          const response = await fetch(`/products/${handle}.js`);

          if (!response.ok) throw new Error('Could not load product variants.');

          const product = await response.json();

          const variant = product.variants.find((item) => String(item.id) === String(variantId));

          if (!variant) throw new Error('Selected variant not found.');

          let image = variant.featured_image?.src || product.featured_image || block.dataset.variantImage || '';

          // Make protocol-relative URLs absolute
          if (image.startsWith('//')) image = `https:${image}`;

          const params = new URLSearchParams({
            shop: block.dataset.shop,
            productId: String(product.id),
            variantId: String(variant.id),
            variantTitle: variant.public_title || variant.title,
            image,
            currency: block.dataset.currency,
            framePrice: String(variant.price),
          });

          window.location.href = `${CONFIGURATOR_URL}?${params.toString()}`;
        } catch (error) {
          console.error('LensCraft variant lookup failed:', error);
          alert('Unable to load the selected frame. Please try again.');
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Customize Lens",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a Customize Lens button to a product page."
    }
  ]
}
{% endschema %}
