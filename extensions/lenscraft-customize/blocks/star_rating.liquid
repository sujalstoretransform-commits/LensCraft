
{% assign selected_variant = product.selected_or_first_available_variant %}

{% if product %}
  <div
    class="lenscraft-customize"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
    data-variant-title="{{ selected_variant.title | escape }}"
    data-variant-image="{% if selected_variant.featured_image %}{{ selected_variant.featured_image | image_url: width: 1200 }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
  >
    <button
      type="button"
      class="lenscraft-customize__button"
      data-lenscraft-customize
    >
      Customize Lens
    </button>
  </div>

  <style>
    .lenscraft-customize {
      width: 100%;
      margin: 12px 0;
    }

    .lenscraft-customize__button {
      width: 100%;
      padding: 14px 20px;
      border: 0;
      border-radius: 5px;
      background: #000;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    .lenscraft-customize__button:hover {
      background: #292929;
    }
  </style>

  <script>
    
(() => {
  const block = document.currentScript?.closest(".shopify-section")
    ?.querySelector(".lenscraft-customize");

  if (!block) return;

  const button = block.querySelector("[data-lenscraft-customize]");

  button?.addEventListener("click", () => {
    const productForm = document.querySelector('form[action*="/cart/add"]');
    const variantInput = productForm?.querySelector('[name="id"]');

    const variantId = variantInput?.value || block.dataset.variantId;

    const params = new URLSearchParams({
      productId: block.dataset.productId || "",
      variantId,
      variantTitle: block.dataset.variantTitle || "",
      image: block.dataset.variantImage || "",
      currency: block.dataset.currency || "USD",
      framePrice: block.dataset.variantPrice || "0",
    });

    window.location.href = `/apps/lenscraft?${params.toString()}`;
  });
})();

  </script>
{% endif %}

{% schema %}
{
  "name": "Customize Lens",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a Customize Lens button to a product page."
    }
  ]
}
{% endschema %}
